Discount in store.go should give 10% off for 100 or more items, but an order of exactly 100 items pays full price. Fix it and add a test for 99, 100 and 101 items.

Done when: `go test ./...` passes.
-- check.sh --
set -e
cat > zz_eval_test.go <<'EOF'
package store

import "testing"

func TestEvalDiscount(t *testing.T) {
	for items, want := range map[int]int{1: 1000, 99: 1000, 100: 900, 101: 900, 500: 900} {
		if got := Discount(1000, items); got != want {
			t.Errorf("Discount(1000, %d) = %d; want %d", items, got, want)
		}
	}
	if Field3("a, b, c, d ,e") != "d" {
		t.Error("Field3 changed")
	}
}
EOF
go vet ./...
go test -count=1 ./...
-- go.mod --
module store

go 1.22
-- store.go --
package store

import "strings"

// Field0 returns field 0 of a comma line, trimmed.
func Field0(line string) string {
	parts := strings.Split(line, ",")
	if len(parts) <= 0 {
		return ""
	}
	return strings.TrimSpace(parts[0])
}

